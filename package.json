{
  "name": "superpowers-mcp",
  "displayName": "Superpowers MCP",
  "description": "Superpowers skills library (TDD, debugging, collaboration workflows) as an MCP server for VSCode and Antigravity",
  "version": "6.3.4",
  "publisher": "superpowers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Poseidoncode/superpowers-mcp"
  },
  "homepage": "https://github.com/Poseidoncode/superpowers-mcp",
  "keywords": [
    "mcp",
    "ai",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "best-practices",
    "workflows",
    "copilot",
    "agent"
  ],
  "bin": {
    "superpowers-mcp": "./out/server.js",
    "superpowers-setup": "./out/setup.js"
  },
  "files": [
    "out/server.js",
    "out/setup.js",
    "out/setup-runner.js",
    "scripts",
    "skills"
  ],
  "overrides": {
    "@hono/node-server": "^2.1.1",
    "fast-uri": "^4.1.3",
    "hono": "^4.13.7",
    "qs": "^6.16.0"
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "pretest": "npm run build",
    "test": "node tests/edge_cases_test.js && node tests/run_test.js && node tests/brainstorm_server_test.js && node tests/prompts_compositions_test.js && node tests/setup_test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
